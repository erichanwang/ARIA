{
  "name": "aria-extension",
  "version": "0.1.0",
  "description": "ARIA — Adaptive Real-time Intelligent Agent. A Chrome MV3 extension with a voice-controlled agent cursor powered by Claude.",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/download-assets.mjs || true",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "package": "node scripts/package-extension.mjs",
    "train": "node scripts/train-cli.mjs",
    "train:voice": "esbuild scripts/train-voice-model.ts --bundle --platform=node --format=esm --packages=external --outfile=.voice-training/train-voice-model.mjs && node .voice-training/train-voice-model.mjs",
    "eval:intent": "esbuild scripts/eval-intent-accuracy.ts --bundle --platform=node --format=esm --packages=external --outfile=.voice-training/eval-intent-accuracy.mjs && node .voice-training/eval-intent-accuracy.mjs",
    "eval:latency": "esbuild scripts/eval-pipeline-latency.ts --bundle --platform=node --format=esm --packages=external --outfile=.voice-training/eval-pipeline-latency.mjs && node .voice-training/eval-pipeline-latency.mjs",
    "eval:dom-finder": "esbuild scripts/eval-dom-finder.ts --bundle --platform=node --format=esm --packages=external --outfile=.voice-training/eval-dom-finder.mjs && node .voice-training/eval-dom-finder.mjs",
    "eval:stt": "esbuild scripts/eval-stt-accuracy.ts --bundle --platform=node --format=esm --packages=external --outfile=.voice-training/eval-stt-accuracy.mjs && node .voice-training/eval-stt-accuracy.mjs",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ tests/ scripts/ --ext .ts,.tsx",
    "lint:fix": "eslint src/ tests/ scripts/ --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\" \"tests/**/*.{ts,tsx,js,jsx,json}\" \"scripts/**/*.{ts,tsx,js,jsx,json}\" \"*.{js,ts,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json}\" \"tests/**/*.{ts,tsx,js,jsx,json}\" \"scripts/**/*.{ts,tsx,js,jsx,json}\" \"*.{js,ts,json,md}\"",
    "preview": "vite preview"
  },
  "license": "MIT",
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.0.270",
    "@types/node": "^20.19.42",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "^4.1.8",
    "esbuild": "^0.21.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^18.2.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-promise": "^7.3.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.14",
    "@picovoice/porcupine-web": "^3.0.3",
    "@picovoice/web-voice-processor": "^4.0.9",
    "@tensorflow/tfjs-backend-cpu": "^4.22.0",
    "@tensorflow/tfjs-core": "^4.22.0",
    "@tensorflow/tfjs-layers": "^4.22.0",
    "zod": "^3.23.8"
  }
}
